{
  "compilerOptions": {
    "rootDir": ".",

    /* Language and Environment */
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "useDefineForClassFields": true,

    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "importHelpers": true,
    "verbatimModuleSyntax": true,

    /* Emit */
    "noEmit": true,
    "incremental": true,

    /* Type Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "types": [
      "node",
      "vitest/globals"
    ],

    /**
     * `@linteljs/create`'s ring aliases, for what sits outside a package and reads its source: the root scripts, run
     * by tsx, which reads this file. A child's `paths` replaces this map rather than merging, so each package
     * declares its own.
     */
    "paths": {
      "@answers": ["./packages/create/src/answers/index.ts"],
      "@answers/*": ["./packages/create/src/answers/*"],
      "@config/*": ["./packages/create/src/config/*"],
      "@disk": ["./packages/create/src/disk/index.ts"],
      "@disk/*": ["./packages/create/src/disk/*"],
      "@e2e/*": ["./packages/create/e2e/*"],
      "@emitters": ["./packages/create/src/emitters/index.ts"],
      "@emitters/*": ["./packages/create/src/emitters/*"],
      "@pipeline": ["./packages/create/src/pipeline/index.ts"],
      "@pipeline/*": ["./packages/create/src/pipeline/*"],
      "@spawns": ["./packages/create/src/spawns/index.ts"],
      "@spawns/*": ["./packages/create/src/spawns/*"],
      "@targets": ["./packages/create/src/targets/index.ts"],
      "@targets/*": ["./packages/create/src/targets/*"],
      "@terminal": ["./packages/create/src/terminal/index.ts"],
      "@terminal/*": ["./packages/create/src/terminal/*"],
      "@utils/*": ["./packages/create/src/utils/*"]
    }
  },

  "include": [
    "**/*.ts",
    "**/*.mts",
    // A wildcard skips dot folders; the repo mod's classic hook is Node code, its tsconfig.json excludes it.
    ".claude/skills/linteljs/hooks/checkStatusHook.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.tmp.ts"
  ]
}
