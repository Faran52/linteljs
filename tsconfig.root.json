{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * Off for the same reason `packages/eslint-config` turns it off: `eslint.config.ts` composes
     * layers out of that package's source, and ESLint types a config field as `X | undefined`
     * rather than `X?`, so spreading a preset is rejected on every property it left out.
     */
    "exactOptionalPropertyTypes": false,

    // The scripts name the `.ts` in a relative specifier, as the shipped ones must for Node. Nothing is emitted.
    "allowImportingTsExtensions": true
  },

  // `pnpm -r typecheck` runs each package and skips the root, so nothing else checks these.
  "include": [
    "eslint.config.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",

    // The repo mod's one classic hook command, run by node; its tsconfig.json checks the rest as mod code.
    ".claude/skills/linteljs/hooks/checkStatus.ts",

    // The layers `eslint.config.ts` pulls in from source lean on these shims for plugins that ship no types.
    "packages/eslint-config/typings/**/*.d.ts"
  ]
}
