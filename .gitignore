node_modules/
dist/
coverage/
.vitest/
*.tsbuildinfo
.vitest-cache/
.DS_Store
.idea/
.e2e/
.e2e-cache/
.compat/
.smoke/
.worktrees/

# Generated from src/rules/*/README.md by scripts/build/rule-docs/ruleDocsBuild.ts at build, packed into the
# tarball because every version through 1.0.3 published this path.
packages/eslint-plugin/docs/

# Stryker writes its report into the package it ran in, and its sandboxes under .stryker-tmp.
packages/*/reports/
.stryker-tmp/

# The declarations Claude Code writes beside a mod it loads (`pnpm mod-types`), for this engine version only.
**/.claude-plugin/types/

# Throwaway scripts: never committed, linted or typechecked.
*.tmp.ts

# pnpm's local content-addressed store, created when a run sets store-dir inside the repo.
.pnpm-store/

# Worktrees the coding agent harness creates for background agents. Never shared.
.claude/worktrees/
