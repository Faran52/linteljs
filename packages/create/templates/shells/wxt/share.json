{
  "$schema": "../../schemas/share.schema.json",
  "layers": [
    "shared"
  ],
  "defaults": {
    "browser": "chrome",
    "hostedFramework": "off",
    "testing": "vitest",
    "e2e": "off",
    "libraries": [
      "es-toolkit"
    ],
    "styling": "css"
  },
  "dependencies": [
    "qs"
  ],
  "devDependencies": [
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "@crxjs/vite-plugin",
    "@linteljs/eslint-config",
    "@types/node",
    "@types/qs",
    "eslint",
    "husky",
    "jiti",
    "lint-staged",
    "stylelint",
    "stylelint-config-recess-order",
    "stylelint-config-standard",
    "stylelint-order",
    "typescript",
    "vite"
  ],
  "pages": {
    "surface:popup": "src/popup",
    "surface:background": "src/background",
    "surface:devtools": "src/devtools",
    "surface:panel": "src/panel"
  },
  "tsconfig": {
    "compilerOptions": {
      "paths": {
        "@components/*": [
          "./src/components/*"
        ],
        "@ui/*": [
          "./src/components/ui/*"
        ],
        "@features/*": [
          "./src/components/features/*"
        ],
        "@lib/*": [
          "./src/lib/*"
        ],
        "@utils/*": [
          "./src/lib/utils/*"
        ],
        "@services/*": [
          "./src/lib/services/*"
        ],
        "@model/*": [
          "./src/lib/model/*"
        ],
        "@styles/*": [
          "./src/styles/*"
        ],
        "@config/*": [
          "./src/config/*"
        ],
        "@i18n/*": [
          "./src/i18n/*"
        ]
      }
    }
  },
  "place": {
    "naming": "camel",
    "tests": ".test",
    "ui": "src/components/ui",
    "features": "src/components/features",
    "lib": "src/lib",
    "i18n": "src/i18n",
    "config": "src/config",
    "styles": "src/styles",
    "typings": "src/typings",
    "public": "public",
    "mocks": "__mocks__"
  },
  "platform": "web",
  "pageKind": "surfaces"
}
