{
  "$schema": "../../schemas/share.schema.json",
  "layers": [
    "shared",
    "bindings/svelte"
  ],
  "ui": [
    "svelte"
  ],
  "defaults": {
    "testing": "vitest",
    "e2e": "off",
    "stories": "off",
    "libraries": [
      "es-toolkit"
    ],
    "styling": "css",
    "form": "form-actions",
    "store": "runes",
    "data": "fetch",
    "mocking": "local"
  },
  "dependencies": [
    "qs",
    "svelte"
  ],
  "devDependencies": [
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "@html-eslint/eslint-plugin",
    "@html-eslint/parser",
    "@inlang/paraglide-js",
    "@inlang/plugin-message-format",
    "@linteljs/eslint-config",
    "@sveltejs/adapter-auto",
    "@sveltejs/kit",
    "@sveltejs/vite-plugin-svelte",
    "@types/node",
    "@types/qs",
    "eslint",
    "eslint-plugin-svelte",
    "husky",
    "jiti",
    "lint-staged",
    "postcss",
    "postcss-html",
    "stylelint",
    "stylelint-config-recess-order",
    "stylelint-config-standard",
    "stylelint-order",
    "svelte-check",
    "svelte-eslint-parser",
    "typescript",
    "vite"
  ],
  "pages": {
    "home": "src/routes",
    "about": "src/routes/about",
    "version": "src/routes/version",
    "contact": "src/routes/contact"
  },
  "tsconfig": {
    "compilerOptions": {
      "paths": {
        "@components/*": [
          "./src/components/*"
        ],
        "@ui/*": [
          "./src/components/ui/*"
        ],
        "@features/*": [
          "./src/components/features/*"
        ],
        "@lib/*": [
          "./src/lib/*"
        ],
        "@store/*": [
          "./src/lib/store/*"
        ],
        "@hooks/*": [
          "./src/lib/hooks/*"
        ],
        "@utils/*": [
          "./src/lib/utils/*"
        ],
        "@services/*": [
          "./src/lib/services/*"
        ],
        "@apis/*": [
          "./src/lib/apis/*"
        ],
        "@styles/*": [
          "./src/styles/*"
        ],
        "@config/*": [
          "./src/config/*"
        ],
        "@i18n/*": [
          "./src/i18n/*"
        ],
        "@mocks/*": [
          "./__mocks__/*"
        ]
      }
    }
  },
  "place": {
    "naming": "camel",
    "tests": ".test",
    "ui": "src/components/ui",
    "features": "src/components/features",
    "lib": "src/lib",
    "i18n": "src/i18n",
    "config": "src/config",
    "styles": "src/styles",
    "typings": "src/typings",
    "public": "static",
    "mocks": "__mocks__",
    "pages": "src/views/{page}/{Page}View"
  },
  "platform": "web",
  "pageKind": "routes",
  "framework": "svelte"
}
