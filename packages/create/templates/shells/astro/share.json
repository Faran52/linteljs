{
  "$schema": "../../schemas/share.schema.json",
  "defaults": {
    "hostedFramework": "off",
    "testing": "vitest",
    "e2e": "off",
    "libraries": [
      "es-toolkit"
    ],
    "styling": "css",
    "form": "astro-actions",
    "store": "nanostores",
    "data": "fetch",
    "mocking": "local"
  },
  "dependencies": [
    "astro",
    "qs"
  ],
  "devDependencies": [
    "@astrojs/check",
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "@linteljs/eslint-config",
    "@types/node",
    "@types/qs",
    "astro-eslint-parser",
    "eslint",
    "eslint-plugin-astro",
    "husky",
    "jiti",
    "lint-staged",
    "stylelint",
    "stylelint-config-recess-order",
    "stylelint-config-standard",
    "stylelint-order",
    "typescript"
  ],
  "pages": {
    "home": "src/views/home",
    "about": "src/views/about",
    "version": "src/views/version",
    "contact": "src/views/contact"
  },
  "tsconfig": {
    "compilerOptions": {
      "paths": {
        "@layouts/*": [
          "./src/layouts/*"
        ],
        "@views/*": [
          "./src/views/*"
        ],
        "@components/*": [
          "./src/components/*"
        ],
        "@ui": [
          "./src/components/ui"
        ],
        "@ui/*": [
          "./src/components/ui/*"
        ],
        "@features/*": [
          "./src/components/features/*"
        ],
        "@lib/*": [
          "./src/lib/*"
        ],
        "@store/*": [
          "./src/lib/store/*"
        ],
        "@utils/*": [
          "./src/lib/utils/*"
        ],
        "@services/*": [
          "./src/lib/services/*"
        ],
        "@apis/*": [
          "./src/lib/apis/*"
        ],
        "@styles/*": [
          "./src/styles/*"
        ],
        "@config/*": [
          "./src/config/*"
        ],
        "@i18n/*": [
          "./src/i18n/*"
        ],
        "@mocks/*": [
          "./__mocks__/*"
        ]
      }
    }
  }
}
