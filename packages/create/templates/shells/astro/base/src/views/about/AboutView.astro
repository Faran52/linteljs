---
import {
  CHECK,
  GATE,
  SYNC,
} from '@config/linteljs';
import { STANDARD_PATHS } from '@config/standard';

import { t } from '@i18n/i18n';

import CodeText from '@ui/code-text/CodeText.astro';

import Layout from '@layouts/Layout.astro';

import { styles } from './AboutView.styles';
---

<Layout titleKey="about">
  <main {...styles.page}>
    <h1 {...styles.pageTitle} data-i18n="about">{t('about')}</h1>
    <p {...styles.pageLede} data-i18n="aboutLede">{t('aboutLede')}</p>

    <section {...styles.section}>
      <h2 {...styles.sectionTitle} data-i18n="aboutGate">{t('aboutGate')}</h2>
      <ul {...styles.rows}>
        {GATE
          .map((leg) => {
            return (
              <li {...styles.row}>
                <code {...styles.keyCode}>{leg.command}</code>
                <span {...styles.value}>{leg.runs}</span>
              </li>
            );
          })}
      </ul>
      <p
        {...styles.note}
        data-i18n="aboutCheck"
        data-command={CHECK}
      >
        <CodeText text={t('aboutCheck', { command: CHECK })} tone="primary" />
      </p>
    </section>

    <section {...styles.section}>
      <h2 {...styles.sectionTitle} data-i18n="aboutStandard">{t('aboutStandard')}</h2>
      <dl {...styles.rows}>
        {STANDARD_PATHS
          .map((entry) => {
            return (
              <div {...styles.row}>
                <dt {...styles.key}><code>{entry.path}</code></dt>
                <dd {...styles.value} data-i18n={entry.holds}>{t(entry.holds)}</dd>
              </div>
            );
          })}
      </dl>
    </section>

    <section {...styles.section}>
      <h2 {...styles.sectionTitle} data-i18n="aboutCurrent">{t('aboutCurrent')}</h2>
      <p
        {...styles.note}
        data-i18n="aboutSync"
        data-command={SYNC}
      >
        <CodeText text={t('aboutSync', { command: SYNC })} tone="primary" />
      </p>
    </section>
  </main>
</Layout>
