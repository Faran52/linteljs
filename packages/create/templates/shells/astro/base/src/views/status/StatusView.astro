---
import { type MessageKey, t } from '@i18n/i18n';

import Layout from '@layouts/Layout.astro';

import { styles } from './StatusView.styles';

interface Props {
  code: number;
  message: MessageKey;
}

const { code, message } = Astro.props;
---

<Layout titleKey={message}>
  <main {...styles.status}>
    <h1 {...styles.statusCode}>{code}</h1>
    <p
      {...styles.statusMessage}
      role="alert"
      data-i18n={message}
    >{t(message)}
    </p>
    <div {...styles.statusActions}>
      <a
        {...styles.action(false)}
        href="/"
        data-i18n="statusHome"
      >{t('statusHome')}
      </a>
    </div>
  </main>
</Layout>
