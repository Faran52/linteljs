---
import { ANSWERS, STACK } from '@config/linteljs';

import { t } from '@i18n/i18n';

import CodeText from '@ui/code-text/CodeText.astro';

import Layout from '@layouts/Layout.astro';

import { styles } from './VersionView.styles';

const RECORDED = {
  file: 'linteljs.config.json',
  command: 'sync',
};
---

<!-- Recorded when the project was generated: a page rendered on the server cannot read that machine. -->
<Layout titleKey="version">
  <main {...styles.page}>
    <h1 {...styles.pageTitle} data-i18n="version">{t('version')}</h1>
    <p {...styles.pageLede} data-i18n="versionLede">{t('versionLede')}</p>

    <section {...styles.section}>
      <h2 {...styles.sectionTitle} data-i18n="versionStack">{t('versionStack')}</h2>
      <dl {...styles.rows}>
        {STACK
          .map((entry) => {
            return (
              <div {...styles.row}>
                <dt {...styles.key}>{entry.name}</dt>
                <dd {...styles.value}>{entry.version}</dd>
              </div>
            );
          })}
      </dl>
    </section>

    <section {...styles.section}>
      <h2 {...styles.sectionTitle} data-i18n="versionAnswers">{t('versionAnswers')}</h2>
      <dl {...styles.rows}>
        {ANSWERS
          .map((entry) => {
            return (
              <div {...styles.row}>
                <dt {...styles.key} data-i18n={entry.label}>{t(entry.label)}</dt>
                <dd {...styles.value}>{entry.value}</dd>
              </div>
            );
          })}
      </dl>
      <p
        {...styles.note}
        data-i18n="versionRecorded"
        data-file={RECORDED.file}
        data-command={RECORDED.command}
      >
        <CodeText text={t('versionRecorded', RECORDED)} tone="primary" />
      </p>
    </section>
  </main>
</Layout>
