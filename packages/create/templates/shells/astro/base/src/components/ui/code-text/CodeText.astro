---
import { partsOf } from '@i18n/i18n';

import { styles } from './CodeText.styles';

interface Props {
  text: string;
  tone?: keyof typeof styles;
}

const { text, tone } = Astro.props;
const toneStyle = tone === undefined ? undefined : styles[tone];
---

{partsOf(text)
  .map((part, index) => {
    return index % 2 === 0 ? part : <code {...toneStyle}>{part}</code>;
  })}
