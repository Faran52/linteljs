{
  "$schema": "../../schemas/share.schema.json",
  "layers": [
    "shared"
  ],
  "ui": [
    "react",
    "react-dom"
  ],
  "defaults": {
    "testing": "vitest",
    "e2e": "off",
    "stories": "off",
    "libraries": [
      "es-toolkit"
    ],
    "styling": "css",
    "form": "react-actions",
    "router": "single-page",
    "store": "react-state",
    "data": "fetch",
    "mocking": "local"
  },
  "dependencies": [
    "i18next",
    "qs",
    "react",
    "react-dom",
    "react-i18next"
  ],
  "devDependencies": [
    "@commitlint/cli",
    "@commitlint/config-conventional",
    "@eslint-react/eslint-plugin",
    "@linteljs/eslint-config",
    "@types/node",
    "@types/qs",
    "@types/react",
    "@types/react-dom",
    "@vitejs/plugin-react",
    "eslint",
    "eslint-plugin-jsx-a11y-x",
    "eslint-plugin-react-hooks",
    "husky",
    "jiti",
    "lint-staged",
    "stylelint",
    "stylelint-config-recess-order",
    "stylelint-config-standard",
    "stylelint-order",
    "typescript",
    "vite"
  ],
  "pages": {
    "home": "src/pages/home",
    "about": "src/pages/about",
    "version": "src/pages/version",
    "contact": "src/pages/contact"
  },
  "tsconfig": {
    "compilerOptions": {
      "paths": {
        "@router/*": [
          "./src/router/*"
        ],
        "@pages/*": [
          "./src/pages/*"
        ],
        "@components/*": [
          "./src/components/*"
        ],
        "@ui": [
          "./src/components/ui"
        ],
        "@ui/*": [
          "./src/components/ui/*"
        ],
        "@features/*": [
          "./src/components/features/*"
        ],
        "@lib/*": [
          "./src/lib/*"
        ],
        "@store/*": [
          "./src/lib/store/*"
        ],
        "@hooks/*": [
          "./src/lib/hooks/*"
        ],
        "@utils/*": [
          "./src/lib/utils/*"
        ],
        "@services/*": [
          "./src/lib/services/*"
        ],
        "@apis/*": [
          "./src/lib/apis/*"
        ],
        "@styles/*": [
          "./src/styles/*"
        ],
        "@config/*": [
          "./src/config/*"
        ],
        "@i18n/*": [
          "./src/i18n/*"
        ],
        "@mocks/*": [
          "./__mocks__/*"
        ]
      }
    }
  },
  "place": {
    "naming": "camel",
    "tests": ".test",
    "ui": "src/components/ui",
    "features": "src/components/features",
    "lib": "src/lib",
    "i18n": "src/i18n",
    "config": "src/config",
    "styles": "src/styles",
    "typings": "src/typings",
    "public": "public",
    "mocks": "__mocks__",
    "pages": "{dir}/{Page}Page"
  },
  "platform": "web",
  "pageKind": "routes",
  "framework": "react"
}
