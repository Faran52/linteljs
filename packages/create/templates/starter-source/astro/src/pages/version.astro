---
import { ANSWERS, STACK } from '../config/linteljs';
import Layout from '../layouts/Layout.astro';
---

<!-- What was recorded at birth: a page rendered on the server still cannot read the machine that generated it. -->
<Layout title="Version">
  <main class="page">
    <h1 class="page-title">Version</h1>
    <p class="page-lede">What this project is running, and the answers it was generated from.</p>

    <section class="section">
      <h2 class="section-title">Stack</h2>
      <dl class="rows">
        {STACK
          .map((entry) => {
            return (
              <div class="row">
                <dt>{entry.name}</dt>
                <dd>{entry.version}</dd>
              </div>
            );
          })}
      </dl>
    </section>

    <section class="section">
      <h2 class="section-title">Your answers</h2>
      <dl class="rows">
        {ANSWERS
          .map((entry) => {
            return (
              <div class="row">
                <dt>{entry.label}</dt>
                <dd>{entry.value}</dd>
              </div>
            );
          })}
      </dl>
      <p class="note">
        Recorded in <code>linteljs.config.json</code>, which <code>sync</code> reads.
      </p>
    </section>
  </main>
</Layout>
