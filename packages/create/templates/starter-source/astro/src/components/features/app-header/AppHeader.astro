---
import { PAGES } from '@config/routes';

import { isCurrentPath } from '@utils/currentPathUtils';

import { styles } from './styles';

interface Props {
  name: string;
}

const { name } = Astro.props;
const here = Astro.url.pathname;
---

<!-- Real links: Astro renders each page on the server. -->
<header {...styles.header}>
  <p {...styles.starterLabel}>LintelJS Starter</p>
  <p {...styles.brand}>{name}</p>
  <nav {...styles.tabs} aria-label="Main">
    {PAGES
      .map((page) => {
        const isCurrent = isCurrentPath(here, page.path);

        return (
          <a
            {...styles.tab(isCurrent)}
            href={page.path}
            aria-current={isCurrent ? 'page' : undefined}
          >
            {page.label}
          </a>
        );
      })}
  </nav>
</header>
