---
import {
  bootScript,
  type MessageKey,
  t,
} from '@i18n';

import { NAME } from '@config/linteljs';

import AppHeader from '@features/app-header/AppHeader.astro';

import '../styles/global.css';

interface Props {
  titleKey?: MessageKey;
}

const { titleKey } = Astro.props;
const title = titleKey === undefined ? NAME : t(titleKey);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta name="generator" content={Astro.generator} />
    <title data-i18n={titleKey}>{title}</title>
    <!-- Inline, so lang and dir are set before the first paint. -->
    <script is:inline set:html={bootScript()} />
    <!-- StyleX injects its dev CSS into `index.html`; each Astro page is a full load, so the link alone is current. -->
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
  </head>
  <body>
    <AppHeader name={NAME} />
    <slot />
    <script>
      import { startLanguage } from '@i18n';

      startLanguage();
    </script>
  </body>
</html>
