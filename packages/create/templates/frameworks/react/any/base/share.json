{
  "package": {
    "dependencies": {
      "i18next": "^26.4.2",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "react-i18next": "^17.0.15"
    }
  },
  "routes": [
    { "path": "/", "name": "home", "from": "@pages/home/HomePage" },
