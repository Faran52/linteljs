{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /**
     * The repository root, so a script can import the shared `scripts/utils/`. Nothing is emitted from here and
     * tsdown ignores it: the build is byte-identical either way.
     */
    "rootDir": "../..",

    // `scripts/` names the `.ts` in a relative specifier, as the shipped scripts must for Node. Nothing is emitted.
    "allowImportingTsExtensions": true,

    "paths": {
      "@mocks/*": ["./__mocks__/*"],
      "@answers": ["./src/answers/index.ts"],
      "@answers/*": ["./src/answers/*"],
      "@config/*": ["./src/config/*"],
      "@disk": ["./src/disk/index.ts"],
      "@disk/*": ["./src/disk/*"],
      "@emitters": ["./src/emitters/index.ts"],
      "@emitters/*": ["./src/emitters/*"],
      "@pipeline": ["./src/pipeline/index.ts"],
      "@pipeline/*": ["./src/pipeline/*"],
      "@spawns": ["./src/spawns/index.ts"],
      "@spawns/*": ["./src/spawns/*"],
      "@targets": ["./src/targets/index.ts"],
      "@targets/*": ["./src/targets/*"],
      "@terminal": ["./src/terminal/index.ts"],
      "@terminal/*": ["./src/terminal/*"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "bin/**/*.ts",
    "src/**/*.ts",
    "__mocks__/**/*.ts",
    "scripts/**/*.ts",
    "templates/project/scripts/**/*.ts",
    "templates/project/plugins/**/*.ts",
    "tsdown.config.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ]
}
