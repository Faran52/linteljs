{
  "name": "@linteljs/create",
  "version": "2.0.0",
  "description": "Scaffold a project with the linteljs standard: ESLint layers, tsconfig, git hooks and agent rules.",
  "license": "MIT",
  "author": "Faran Ali",
  "homepage": "https://github.com/Faran52/linteljs#readme",
  "bugs": {
    "url": "https://github.com/Faran52/linteljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faran52/linteljs.git",
    "directory": "packages/create"
  },
  "keywords": [
    "create",
    "scaffold",
    "starter",
    "boilerplate",
    "eslint",
    "angular",
    "next",
    "react",
    "solid",
    "svelte",
    "typescript",
    "vue"
  ],
  "type": "module",
  "bin": {
    "create-linteljs": "./dist/create-linteljs.mjs",
    "create": "./dist/create-linteljs.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "!templates/project/scripts/**/*.test.ts",
    "!templates/project/plugins/**/*.test.ts",
    "!templates/**/node_modules",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "collect:builds": "tsx scripts/collect-builds/collectBuildsScript.ts",
    "prepack": "pnpm run build",
    "schema": "tsx scripts/write-schemas/writeSchemasScript.ts",
    "smoke": "tsx scripts/smoke/smokeScript.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "es-toolkit": "catalog:"
  },
  "devDependencies": {
    "@linteljs/eslint-config": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "playwright-core": "^1.63.0",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
