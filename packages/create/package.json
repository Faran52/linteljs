{
  "name": "@linteljs/create",
  "version": "1.6.0",
  "description": "Scaffold a project with the linteljs standard: ESLint layers, tsconfig, git hooks and agent rules.",
  "license": "MIT",
  "author": "Faran Ali",
  "homepage": "https://github.com/Faran52/linteljs#readme",
  "bugs": {
    "url": "https://github.com/Faran52/linteljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faran52/linteljs.git",
    "directory": "packages/create"
  },
  "keywords": [
    "create",
    "scaffold",
    "starter",
    "boilerplate",
    "eslint",
    "angular",
    "next",
    "react",
    "solid",
    "svelte",
    "typescript",
    "vue"
  ],
  "type": "module",
  "bin": {
    "create-linteljs": "./bin/create-linteljs.js",
    "create": "./bin/create-linteljs.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "!templates/project/scripts/*.test.ts",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsdown",
    "collect:builds": "JITI_TSCONFIG_PATHS=1 jiti scripts/collectBuildScripts.ts",
    "prepack": "pnpm run build",
    "schema": "JITI_TSCONFIG_PATHS=1 jiti scripts/writeSchemas.ts",
    "smoke": "node scripts/smoke.js",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@linteljs/eslint-config": "workspace:*",
    "jiti": "catalog:",
    "typescript": "catalog:"
  }
}
