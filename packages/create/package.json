{
  "name": "@linteljs/create",
  "version": "1.6.0",
  "description": "Scaffold a project with the linteljs standard: ESLint layers, tsconfig, git hooks and agent rules.",
  "license": "MIT",
  "author": "Faran Ali",
  "homepage": "https://github.com/Faran52/linteljs#readme",
  "bugs": {
    "url": "https://github.com/Faran52/linteljs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faran52/linteljs.git",
    "directory": "packages/create"
  },
  "keywords": [
    "create",
    "scaffold",
    "starter",
    "boilerplate",
    "eslint",
    "angular",
    "next",
    "react",
    "solid",
    "svelte",
    "typescript",
    "vue"
  ],
  "type": "module",
  "bin": {
    "create-linteljs": "./dist/create-linteljs.mjs",
    "create": "./dist/create-linteljs.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#mocks/*": "./__mocks__/*.ts",
    "#answers": "./src/answers/index.ts",
    "#answers/*": "./src/answers/*.ts",
    "#config/*": "./src/config/*.ts",
    "#disk": "./src/disk/index.ts",
    "#disk/*": "./src/disk/*.ts",
    "#emitters": "./src/emitters/index.ts",
    "#emitters/*": "./src/emitters/*.ts",
    "#pipeline": "./src/pipeline/index.ts",
    "#pipeline/*": "./src/pipeline/*.ts",
    "#spawns": "./src/spawns/index.ts",
    "#spawns/*": "./src/spawns/*.ts",
    "#targets": "./src/targets/index.ts",
    "#targets/*": "./src/targets/*.ts",
    "#terminal": "./src/terminal/index.ts",
    "#terminal/*": "./src/terminal/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "!templates/project/scripts/**/*.test.ts",
    "!templates/project/plugins/**/*.test.ts",
    "!templates/**/node_modules",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsdown",
    "collect:builds": "jiti scripts/collect-builds/collectBuildsScript.ts",
    "prepack": "pnpm run build",
    "schema": "jiti scripts/write-schemas/writeSchemasScript.ts",
    "smoke": "jiti scripts/smoke/smokeScript.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run",
    "prepare": "pnpm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "es-toolkit": "catalog:"
  },
  "devDependencies": {
    "@linteljs/eslint-config": "workspace:*",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "jiti": "catalog:",
    "typescript": "catalog:"
  }
}
