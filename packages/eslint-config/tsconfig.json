{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    /**
     * The repository root, so a script can import the shared `scripts/utils/`. Nothing is emitted from here and
     * tsdown ignores it: the build is byte-identical either way.
     */
    "rootDir": "../..",

    // `scripts/` names the `.ts` in a relative specifier, as the shipped scripts must for Node. Nothing is emitted.
    "allowImportingTsExtensions": true,

    "paths": {
      "@mocks/*": ["./__mocks__/*"]
    },

    /**
     * Off here, and only here.
     *
     * Every value this package handles is a config object written by somebody else. ESLint
     * types those fields as `X | undefined` rather than `X?`, so spreading a preset and adding
     * a `files` glob (which is most of what a layer does) is rejected on every property that
     * preset happened to leave out. The design doc names this flag as the one that bites in
     * practice against third-party types; this is the seam it bites at.
     *
     * It stays on for the workspace and for every project `@linteljs/create` generates.
     */
    "exactOptionalPropertyTypes": false
  },

  "include": [
    "src/**/*.ts",
    "__mocks__/**/*.ts",
    "typings/**/*.d.ts",
    "scripts/**/*.ts",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],

  // Lint input with tsconfigs of its own; `registerHome.ts` imports an SFC no TypeScript program can resolve.
  "exclude": ["__mocks__/fixtures"]
}
