{
  "name": "@linteljs/eslint-plugin",
  "version": "1.6.0",
  "description": "Opinionated ESLint rules for TypeScript and React: vertical layout, import hygiene, and modern idioms.",
  "homepage": "https://github.com/Faran52/linteljs#readme",
  "license": "MIT",
  "author": "Faran Ali",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faran52/linteljs.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/Faran52/linteljs/issues"
  },
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && jiti scripts/build/dist-manifest/distManifestBuild.ts && jiti scripts/build/rule-docs/ruleDocsBuild.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "smoke": "jiti scripts/release/smoke/smokeRelease.ts",
    "audit:real": "jiti scripts/audit/real-code/realCodeAudit.ts",
    "audit:options": "jiti scripts/audit/real-code/realCodeAudit.ts --options",
    "audit:negatives": "jiti scripts/audit/false-negatives/falseNegativesAudit.ts",
    "audit:security": "jiti scripts/audit/security/securityAudit.ts",
    "mutation": "stryker run",
    "compat": "jiti scripts/release/compat-matrix/compatMatrixRelease.ts",
    "prepare": "pnpm run build"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#mocks/*": "./__mocks__/*.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "astro-eslint-parser": "catalog:",
    "es-toolkit": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "jiti": "catalog:",
    "svelte": "catalog:",
    "svelte-eslint-parser": "catalog:",
    "tsdown": "catalog:",
    "tslib": "^2.8.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "vue-eslint-parser": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=5.0.0"
  },
  "keywords": [
    "codestyle",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "flat-config",
    "formatting",
    "react",
    "typescript",
    "javascript",
    "ecmascript",
    "lint",
    "linting",
    "linter"
  ]
}
