{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // What ships runs on the `engines.node` floor, Node 18. `es2023` would admit `toSorted`, which is Node 20.
    "lib": ["es2022"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.src.tsbuildinfo"
  },

  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
