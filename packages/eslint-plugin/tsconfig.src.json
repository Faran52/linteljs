{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // What ships runs on the `engines.node` floor, Node 22. `es2025` would admit `Promise.try`, which is Node 23.
    "lib": ["es2024"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.src.tsbuildinfo"
  },

  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
