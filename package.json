{
  "name": "linteljs-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": ">=26.8.1",
    "pnpm": ">=12.1.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"packages/*/src/**/*.css\" --allow-empty-input",
    "lint:types": "node scripts/lintTypes.ts",
    "typecheck": "tsc --noEmit -p tsconfig.root.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm lint:types && pnpm lint:css && pnpm typecheck && pnpm test:coverage && pnpm build",
    "e2e:pack": "node scripts/cleanE2ePack.ts && pnpm -r pack --pack-destination .e2e",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
