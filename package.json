{
  "name": "linteljs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.10.0",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"packages/*/src/**/*.css\" \"packages/create/templates/**/*.css\" --allow-empty-input",
    "lint:types": "jiti scripts/lint-types/lintTypesScript.ts",
    "audit:ignores": "jiti scripts/audit-ignores/auditIgnoresScript.ts",
    "lint:starters": "jiti scripts/lint-starters/lintStartersScript.ts",
    "lint:starters:fix": "jiti scripts/lint-starters/lintStartersScript.ts --fix",
    "trees": "jiti scripts/starter-trees/starterTreesScript.ts",
    "typecheck": "tsc --noEmit -p tsconfig.root.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm lint:types && pnpm lint:starters && pnpm lint:css && pnpm typecheck && pnpm test:coverage && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/chrome": "^0.3.0",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "es-toolkit": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "jiti": "catalog:",
    "lint-staged": "^17.5.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "verdaccio": "^6.10.3",
    "vitest": "catalog:"
  }
}
