{
  "name": "linteljs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=26.10.0",
    "pnpm": ">=12.6.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 --concurrency auto",
    "lint:fix": "eslint . --fix --concurrency auto",
    "lint:css": "stylelint \"packages/*/src/**/*.css\" \"packages/create/templates/**/*.css\" --allow-empty-input",
    "lint:types": "node scripts/checkBannedPatterns.ts packages/*/src packages/*/__mocks__ packages/create/e2e",
    "lint:starters": "tsx scripts/lint-starters/lintStartersScript.ts",
    "lint:starters:fix": "tsx scripts/lint-starters/lintStartersScript.ts --fix",
    "typecheck": "tsc --noEmit -p tsconfig.root.json && pnpm -r typecheck && pnpm typecheck:mods",
    "typecheck:mods": "tsx scripts/typecheck-mods/typecheckModsScript.ts",
    "mod-types": "claude -p /cost --plugin-dir .claude/skills/linteljs > /dev/null && claude -p /cost --plugin-dir packages/create/templates/project/plugins/linteljs > /dev/null",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:shard": "vitest run --coverage --coverage.thresholds.100=false --reporter=blob --reporter=default",
    "test:merge": "vitest run --merge-reports --coverage",
    "test:isolated": "tsx scripts/isolated-coverage/isolatedCoverageScript.ts",
    "build": "pnpm -r build",
    "check": "pnpm build && tsx scripts/gate/gateScript.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "es-toolkit": "catalog:",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "jiti": "catalog:",
    "lint-staged": "^17.6.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "verdaccio": "^6.10.4",
    "vitest": "catalog:"
  }
}
